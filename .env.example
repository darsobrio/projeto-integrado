# ---------------------------------------------------------------------------
# Oportunet — exemplo de variáveis de ambiente
# Copie para ".env" e preencha os valores. NUNCA versione o .env.
# ---------------------------------------------------------------------------

# === Django =================================================================
# Gere uma chave longa e aleatória:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=sua-chave-secreta-aqui-aleatoria-e-longa
DEBUG=True

# Hosts permitidos, separados por vírgula. Em produção, liste só o seu domínio.
# Exemplo: ALLOWED_HOSTS=oportunet.com.br,www.oportunet.com.br
ALLOWED_HOSTS=localhost,127.0.0.1

# Origens confiáveis para requisições POST (formulários) em HTTPS.
# Exemplo: CSRF_TRUSTED_ORIGINS=https://oportunet.com.br,https://www.oportunet.com.br
CSRF_TRUSTED_ORIGINS=

# === Banco de dados =========================================================
# sqlite (padrão, desenvolvimento) ou postgres (recomendado em produção)
DB_ENGINE=sqlite

# Só é usado quando DB_ENGINE=postgres. Formato:
#   postgres://USUARIO:SENHA@HOST:PORTA/NOME_BANCO
DATABASE_URL=postgres://usuario:senha@localhost:5432/ifpi_oportunidades

# === Firebase ===============================================================
# Autenticação (Firebase Auth). Encontre em Configurações do projeto > Web API Key.
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=

# Storage (uploads). Só é usado quando USE_FIREBASE_STORAGE=True.
USE_FIREBASE_STORAGE=False
# Bucket do Firebase Storage. Formato: <projeto>.appspot.com ou <projeto>.firebasestorage.app
FIREBASE_STORAGE_BUCKET=

# O arquivo serviceAccountKey.json (credencial do Admin SDK) deve ficar na raiz
# do projeto e NUNCA ser versionado no Git.

# === E-mail =================================================================
# Em DEBUG=True o padrão é imprimir o e-mail no terminal (console).
# Em produção, use smtp e preencha os dados abaixo.
EMAIL_BACKEND=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=seu-email@gmail.com
EMAIL_HOST_PASSWORD=sua-senha-de-app
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Oportunet <nao-responder@oportunet.local>
